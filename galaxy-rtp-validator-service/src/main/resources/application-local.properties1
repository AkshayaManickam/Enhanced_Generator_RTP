# Local development profile - completely disable AWS services
spring.cloud.aws.enabled=false
spring.cloud.aws.parameter-store.enabled=false
spring.cloud.aws.sqs.enabled=false
spring.cloud.aws.s3.enabled=false
spring.cloud.config.enabled=false
spring.cloud.discovery.enabled=false

# Disable AWS auto-configurations
spring.autoconfigure.exclude=io.awspring.cloud.autoconfigure.sqs.SqsAutoConfiguration,io.awspring.cloud.autoconfigure.config.parameterstore.ParameterStoreAutoConfiguration,io.awspring.cloud.autoconfigure.core.AwsAutoConfiguration,io.awspring.cloud.autoconfigure.s3.S3AutoConfiguration

# Disable cloud config
spring.cloud.config.enabled=false
spring.cloud.config.uri=http://localhost:8888
spring.cloud.config.fail-fast=false

# Disable Eureka
eureka.client.enabled=false
eureka.instance.enabled=false

# Disable health config
health.config.enabled=false
